{
  "name": "@edifice.io/rack-frontend",
  "version": "3.2.14-develop-pedago.0",
  "private": true,
  "license": "GPL-3.0",
  "author": "Edifice",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "build:prod": "NODE_ENV=production pnpm run typecheck && vite build",
    "clean": "rm -rf dist node_modules",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "pnpm install",
    "pre-commit": "lint-staged",
    "preview": "vite preview",
    "prune:prod": "CI=true NPM_CONFIG_IGNORE_SCRIPTS=true pnpm prune --prod --production --loglevel verbose",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@edifice.io/utilities": "develop-pedago",
    "@edifice.io/bootstrap": "develop-pedago",
    "@edifice.io/rack-client-rest": "workspace:*",
    "@edifice.io/client": "develop-pedago",
    "@edifice.io/react": "develop-pedago",
    "@edifice.io/collect-frontend": "develop-pedago",
    "@react-spring/web": "9.7.5",
    "@tanstack/react-query": "5.108.0",
    "@uidotdev/usehooks": "2.4.1",
    "antd": "5.29.3",
    "clsx": "2.1.1",
    "i18next": "23.16.8",
    "i18next-http-backend": "2.7.3",
    "pdfjs-dist": "5.7.284",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.1.2",
    "react-hook-form": "7.92.0",
    "react-i18next": "14.1.3",
    "react-pdf": "10.5.0",
    "react-router-dom": "6.30.6",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@axe-core/react": "4.14.0",
    "@tanstack/react-query-devtools": "5.108.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.5.2",
    "msw": "2.15.0",
    "nx": "19.8.14",
    "vite": "5.4.21",
    "vite-tsconfig-paths": "5.1.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "nx": {}
}
